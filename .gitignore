# ---------------------------------------------------------------------------
# Generated experiment artifacts (out/)
#
# Everything under out/ is reproducible:
#   scripts/export_scene.py --env all --out out/     -> *.grid, *.problem
#   ompl planner                                     -> *.path
#   scripts/run_sim.py --save-frames out/            -> frames/*.png
#
# The small text artifacts (*.problem, *.path) are kept in the repo so results
# can be diffed; the big binaries are not.
# ---------------------------------------------------------------------------
out/**/*.grid
out/**/*.npy
out/**/*.npz
out/frames/
out/**/*.png
out/**/*.mp4
out/**/*.gif
out/**/*.log
out/*.path*
# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Packaging / build
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Environments
.venv/
venv/
env/
ENV/
.python-version
.conda/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Notebooks
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Native build output (in case anything here is compiled against OMPL/VAMP)
# ---------------------------------------------------------------------------
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.o
*.a
*.dylib

# ---------------------------------------------------------------------------
# Editors / tooling
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.direnv/
.envrc

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Secrets / local overrides
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
